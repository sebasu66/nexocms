modules = ["nodejs-20"]
[nix]
channel = "stable-25_05"

[deployment]
run = ["sh", "-c", "npm run mcp:dev"]

[userenv]

[userenv.shared]
MCP_PORT = "3000"
NEXO_APP_URL = "http://localhost:3000"
NEXO_MCP_DEMO_MODE = "true"
SUPABASE_URL = "https://yzqichzpmzzabwmwtkpq.supabase.co"

[workflows]
runButton = "MCP Server"

[[workflows.workflow]]
name = "MCP Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run mcp:dev"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3000
externalPort = 80
