modules = ["nodejs-20"]
[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
MCP_PORT = "3000"
NEXO_APP_URL = "http://localhost:5173"
NEXO_MCP_DEMO_MODE = "false"
SUPABASE_URL = "https://yzqichzpmzzabwmwtkpq.supabase.co"
VITE_DEMO_MODE = "false"
VITE_SUPABASE_URL = "https://yzqichzpmzzabwmwtkpq.supabase.co"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "MCP Server"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "MCP Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run mcp:dev"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3000
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80
